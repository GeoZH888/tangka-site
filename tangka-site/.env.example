# =============================================================================
# Copy to .env.local for local development.
# In production set these in Netlify → Site configuration → Environment variables.
# =============================================================================

# Supabase (CLF project)
VITE_SUPABASE_URL=https://yqcojudvvjntaajnrilr.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Which exhibition this site is for (matches feiyi_exhibition.slug)
VITE_EXHIBITION_SLUG=sacred-measures-2026

# Canonical public URL (used for QR codes, og:url, sitemap)
VITE_SITE_BASE_URL=https://david-zhongwen.net/feiyi/tangka

# Vite base path for asset URLs (must match the proxy subpath)
VITE_BASE_PATH=/feiyi/tangka/

# =============================================================================
# Netlify Functions only (NOT prefixed with VITE_ — server-side, never exposed)
# =============================================================================

# Service role key for the David function (privileged DB access)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic API key for David
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...
